# PostgreSQL
POSTGRES_DB=property_manager
POSTGRES_USER=property_manager_user
POSTGRES_PASSWORD=your_password

# Local PostgreSQL port
POSTGRES_LOCAL_PORT=5432

# Spring Boot application port
SPRING_LOCAL_PORT=8080

# Java remote debug port
DEBUG_PORT=5005

# Local datasource URL
DATASOURCE_URL=jdbc:postgresql://localhost:5432/property_manager

# JWT
# Expiration time in milliseconds: 3600000 = 1 hour
JWT_EXPIRATION=3600000
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Users data
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=change_me_demo
